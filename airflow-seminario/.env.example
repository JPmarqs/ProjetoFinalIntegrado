# -----------------------------------------------------------------------------
# Airflow local
# -----------------------------------------------------------------------------
AIRFLOW_UID=50000

# Gere valores proprios antes de iniciar o ambiente.
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=SUBSTITUA_POR_UMA_CHAVE_FERNET
AIRFLOW__API_AUTH__JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL

# -----------------------------------------------------------------------------
# AWS/S3 - configuracao permanente
# As tres credenciais temporarias ficam somente em .env.aws-lab.
# -----------------------------------------------------------------------------
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=nome-globalmente-unico-do-bucket
S3_PREFIX=raw/airflow

# -----------------------------------------------------------------------------
# Fonte no Google Drive
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_FILE_ID=1EsGox0UnBWSaM6mrkNSUlYUOecubLCsh
SOURCE_FILENAME=acidentes2026_todas_causas_tipos.zip
CSV_FILENAME=acidentes2026_todas_causas_tipos.csv
MAX_CSV_SIZE_MB=200

# -----------------------------------------------------------------------------
# Snowflake e dbt
# -----------------------------------------------------------------------------
# Formato recomendado: nome_da_organizacao-nome_da_conta
SNOWFLAKE_ACCOUNT=MINHA_ORGANIZACAO-MINHA_CONTA
SNOWFLAKE_USER=PFI_AIRFLOW
SNOWFLAKE_ROLE=PFI_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=PFI_WH
SNOWFLAKE_DATABASE=PROJETO_FINAL_IA
SNOWFLAKE_SCHEMA=STAGING

# Caminhos vistos de dentro dos containers.
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/snowflake_rsa_key.p8
DBT_PROFILES_DIR=/opt/airflow/dbt

# -----------------------------------------------------------------------------
# Mapbox e imagens no S3
# -----------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=SUBSTITUA_PELO_TOKEN_MAPBOX
MAPBOX_STYLE=mapbox/streets-v12
MAPBOX_ZOOM=17
MAPBOX_IMAGE_WIDTH=400
MAPBOX_IMAGE_HEIGHT=300
MAPBOX_REQUEST_TIMEOUT_SECONDS=30
S3_MAPBOX_IMAGES_PREFIX=mapbox/static-images

# Lote piloto. Aumente gradualmente considerando a cota da API e o laboratorio.
ML_IMAGE_BATCH_SIZE=5

# -----------------------------------------------------------------------------
# Machine learning
# -----------------------------------------------------------------------------
ML_CLASSIFICATION_THRESHOLD=0.37
ML_RANDOM_SEED=42
ML_TEST_SIZE=0.25
S3_ML_ARTIFACTS_PREFIX=ml/artifacts

# -----------------------------------------------------------------------------
# Banco interno local do Metabase (nao e a conexao com Snowflake)
# -----------------------------------------------------------------------------
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL
METABASE_DB_NAME=metabase
